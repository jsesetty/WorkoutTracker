{
  "name": "ironpulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "IronPulse Monorepo — Enterprise Workout & Nutrition Architecture",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "test:e2e": "playwright test",
    "start": "node server.js",
    "db:generate": "npm --workspace=@ironpulse/db run db:generate",
    "db:push": "npm --workspace=@ironpulse/db run db:push",
    "db:migrate": "npm --workspace=@ironpulse/db run db:migrate"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "turbo": "^2.11.7"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
